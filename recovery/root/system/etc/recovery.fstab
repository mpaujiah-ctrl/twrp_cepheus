# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#<src>                                                 <mnt_point>               <type>  <mnt_flags and options>                              <fs_mgr_flags>
system                                                  /system                  ext4    ro,barrier=1,discard                                 wait,logical
system                                                  /system                  erofs   ro,barrier=1                                         wait,logical
vendor                                                  /vendor                  ext4    ro,barrier=1,discard                                 wait,logical
vendor                                                  /vendor                  erofs   ro,barrier=1                                         wait,logical
system_ext                                              /system_ext              ext4    ro,barrier=1,discard                                 wait,logical
system_ext                                              /system_ext              erofs   ro,barrier=1                                         wait,logical
product                                                 /product                 ext4    ro,barrier=1,discard                                 wait,logical
product                                                 /product                 erofs   ro,barrier=1                                         wait,logical
odm                                                     /odm                     ext4    ro,barrier=1,discard                                 wait,logical
odm                                                     /odm                     erofs   ro,barrier=1                                         wait,logical
/dev/block/bootdevice/by-name/metadata                  /metadata                ext4    noatime,nosuid,nodev,discard                         wait,check,formattable
/dev/block/bootdevice/by-name/cache                     /cache                   ext4    noatime,nosuid,nodev,barrier=1                       wait
/dev/block/bootdevice/by-name/userdata                  /data                    ext4    noatime,nosuid,nodev,barrier=1,noauto_da_alloc,inlinecrypt       wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/bootdevice/by-name/userdata                  /data                    f2fs    noatime,nosuid,nodev,fsync_mode=nobarrier,discard,inlinecrypt       wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/bootdevice/by-name/misc                      /misc                    emmc    defaults                                             defaults
